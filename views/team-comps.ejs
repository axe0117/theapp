<!-- OKAY SO THE TEAM COMPS FILE, on load, will fetch all team comps avail and builds 2 lists
1. Team comps where you own every member
2. Team comps where you are one character away from optimal (and should consider pulling that one next) -->

<!-- This file will be dependent on if the team-comps/available
endpoint from routes/team-comps to return the "buildable" and
"almostThere" aka the one-away teams. :D -->

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<title>Your Team Comps</title>
		<link
			rel="stylesheet"
			href="/stylesheets/stylechara.css"
		/>
	</head>
	<body>
		<a href="/characters">&larr; Back to agents</a>
		<h1>Your Team Comps</h1>

		<div id="buildable-section">
			<h2>Ready to build</h2>
			<div id="buildable-list"></div>
		</div>

		<div id="almost-section">
			<h2>One character away</h2>
			<div id="almost-list"></div>
		</div>

		<script>
			async function loadTeamComps() {
				const res = await fetch('/team-comps/available');
				if (!res.ok) {
					document.body.innerHTML +=
						'<p>Please log in to see your team comps.</p>';
					return;
				}
				const { buildable, almostThere } = await res.json();

				function renderMemberIcons(members, missingId = null) {
					return members
						.map(
							(m) => `
                    <div class="team-member ${missingId && m._id === missingId ? 'missing' : ''}">
                        <img src="${m.icon}" alt="${m.name}" title="${m.name}">
                        <span>${m.name}</span>
                    </div>
                `,
						)
						.join('');
				}

				const buildableList = document.getElementById('buildable-list');
				buildable.forEach((comp) => {
					const div = document.createElement('div');
					div.className = 'comp-card';
					div.innerHTML = `
                    <strong>${comp.label}</strong> (${comp.tier})
                    <div class="team-row">${renderMemberIcons(comp.members)}</div>
                    <p class="notes">${comp.notes || ''}</p>
                `;
					buildableList.appendChild(div);
				});

				const almostList = document.getElementById('almost-list');
				almostThere.forEach(({ comp, missing }) => {
					const div = document.createElement('div');
					div.className = 'comp-card dimmed';
					div.innerHTML = `
                    <strong>${comp.label}</strong> (${comp.tier})
                    <div class="team-row">${renderMemberIcons(comp.members, missing._id)}</div>
                    <p class="notes">Missing: <strong>${missing.name}</strong></p>
                `;
					almostList.appendChild(div);
				});
			}

			loadTeamComps();
		</script>
	</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Agents</title>
    <link rel="stylesheet" href="/stylesheets/stylechara.css">
</head>
<body>
    <a href="/index">
    <%-include("layout/header.ejs")%>
    </a>
    <main>
    <h1>Agents</h1>

    <div class="grid">
        <% agents.forEach(agent => { %>
            <div class="card" data-name="<%= agent.name %>">
                <a href="/team-comps/carousel/<%= encodeURIComponent(agent.name) %>">
                    <img src="<%= agent.icon %>" alt="<%= agent.name %>">
                    <p><%= agent.name %></p>
                </a> 
                <button
                    class="owned-toggle <%= ownedNames.includes(agent.name) ? 'is-owned' : '' %>"
                    data-name="<%= agent.name %>"
                >
                    <%= ownedNames.includes(agent.name) ? 'Owned ✓' : 'Mark as Owned' %>
                </button>
            </div>
        <% }); %>
    </div>
    <a href="/team-comps">
<div class="question-buttons">
				<button
					class="question-btn"
				>
					<h3>
						View all possible teams with the agents you own!
					</h3>
				</button>

			</div>
            </a>
</main>
    <script>
        document.querySelectorAll('.owned-toggle').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const name = btn.dataset.name;
                const res = await fetch(`/characters/${encodeURIComponent(name)}/toggle`, {
                    method: 'POST',
                });
                if (!res.ok) {
                    alert('Please log in to track owned characters.');
                    return;
                }
                const data = await res.json();
                btn.classList.toggle('is-owned', data.owned);
                btn.textContent = data.owned ? 'Owned ✓' : 'Mark as Owned';
            });
        });
    </script>

</body>
</html>